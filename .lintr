linters: linters_with_defaults(
    # Named one by one, starting from nothing, because CI installs the newest
    # lintr: with linters_with_defaults() every new default linter would switch
    # itself on and break the build (pipe_consistency_linter did exactly that).
    # Adding a linter here is a deliberate act.
    defaults = list(),
    # mistakes
    equals_na_linter = equals_na_linter(),
    seq_linter = seq_linter(),
    vector_logic_linter = vector_logic_linter(),
    T_and_F_symbol_linter = T_and_F_symbol_linter(),
    semicolon_linter = semicolon_linter(),
    # %<>% is the house style in the get_ functions, plain `=` assignment is not
    assignment_linter = assignment_linter(operator = c("<-", "<<-", "%<>%")),
    # cheap hygiene
    trailing_whitespace_linter = trailing_whitespace_linter(),
    trailing_blank_lines_linter = trailing_blank_lines_linter(),
    whitespace_linter = whitespace_linter(),
    spaces_inside_linter = spaces_inside_linter(),
    function_left_parentheses_linter = function_left_parentheses_linter()
  )
encoding: "UTF-8"
